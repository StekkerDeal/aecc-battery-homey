        "button.reset_meters": {
          "maintenanceAction": true,
          "title": {
            "en": "Reset meters",
            "nl": "Meters resetten"
          },
          "desc": {
            "en": "Resets the charged and discharged energy meters to zero. This breaks the continuity of this device's history in Homey Energy.",
            "nl": "Zet de meters voor geladen en ontladen energie terug naar nul. Dit onderbreekt de continuïteit van de geschiedenis van dit apparaat in Homey Energie."
          }
        }
      },
      "energy": {
        "homeBattery": true,
        "meterPowerImportedCapability": "meter_power.charged",
        "meterPowerExportedCapability": "meter_power.discharged"
