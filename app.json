  "capabilities": {
    "aecc_last_update": {
      "type": "string",
      "title": {
        "en": "Last update",
        "nl": "Laatste update"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "aecc_max_soc": {
      "type": "number",
      "title": {
        "en": "Charge limit",
        "nl": "Oplaadlimiet"
      },
      "units": "%",
      "getable": true,
      "setable": true,
      "min": 50,
      "max": 100,
      "step": 5,
      "decimals": 0,
      "uiComponent": "slider",
      "insights": true
    },
    "aecc_min_soc": {
      "type": "number",
      "title": {
        "en": "Discharge limit",
        "nl": "Ontlaadlimiet"
      },
      "units": "%",
      "getable": true,
      "setable": true,
      "min": 5,
      "max": 50,
      "step": 5,
      "decimals": 0,
      "uiComponent": "slider",
      "insights": true
    },
    "aecc_signal_strength": {
      "type": "number",
      "title": {
        "en": "WiFi signal",
        "nl": "WiFi signaal"
      },
      "units": "dBm",
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    }
  },
  "discovery": {
    "aecc": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "http",
        "protocol": "tcp"
      },
      "id": "{{txt.s_sn}}",
      "conditions": [
        [
          {
            "field": "name",
            "match": {
              "type": "regex",
              "value": "^SXD-mDNS-IF"
            }
          },
          {
            "field": "txt.s_port",
            "match": {
              "type": "regex",
              "value": "^[0-9]+$"
            }
          }
        ]
      ]
    }
  }
}