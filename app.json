{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "nl.stekkerdeal.aecc",
  "version": "1.0.0",
  "compatibility": ">=12.13.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "AECC Battery",
    "nl": "AECC Batterij"
  },
  "description": {
    "en": "Get more out of every stored kilowatt-hour",
    "nl": "Haal meer uit elke opgeslagen kilowattuur"
  },
  "category": [
    "energy"
  ],
  "brandColor": "#0a1826",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "StekkerDeal",
    "email": "info@stekkerdeal.nl"
  },
  "support": "https://github.com/StekkerDeal/aecc-battery-homey/issues",
  "source": "https://github.com/StekkerDeal/aecc-battery-homey",
  "homepage": "https://stekkerdeal.nl",
  "bugs": {
    "url": "https://github.com/StekkerDeal/aecc-battery-homey/issues"
  },
  "drivers": [
    {
      "name": {
        "en": "AECC home battery",
        "nl": "AECC thuisbatterij"
      },
      "class": "battery",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "discovery": "aecc",
      "images": {
        "small": "/drivers/battery/assets/images/small.png",
        "large": "/drivers/battery/assets/images/large.png",
        "xlarge": "/drivers/battery/assets/images/xlarge.png"
      },
      "capabilities": [
        "measure_power",
        "measure_battery",
        "battery_charging_state",
        "meter_power.charged",
        "meter_power.discharged",
        "target_power",
        "target_power_mode",
        "aecc_min_soc",
        "aecc_max_soc",
        "aecc_last_update",
        "button.reset_meters"
      ],
      "capabilitiesOptions": {
        "measure_power": {
          "title": {
            "en": "Battery power",
            "nl": "Batterijvermogen"
          }
        },
        "meter_power.charged": {
          "title": {
            "en": "Charged energy",
            "nl": "Geladen energie"
          }
        },
        "meter_power.discharged": {
          "title": {
            "en": "Discharged energy",
            "nl": "Ontladen energie"
          }
        },
        "target_power": {
          "min": -2400,
          "max": 2400,
          "step": 10,
          "decimals": 0
        },
        "target_power_mode": {
          "values": [
            {
              "id": "device",
              "title": {
                "en": "Self-consumption (AI)",
                "nl": "Zelfconsumptie (AI)"
              }
            },
            {
              "id": "homey",
              "title": {
                "en": "Homey control",
                "nl": "Homey-besturing"
              }
            }
          ]
        },
        "button.reset_meters": {
          "maintenanceAction": true,
          "title": {
            "en": "Reset meters",
            "nl": "Meters resetten"
          },
          "desc": {
            "en": "Resets the charged and discharged energy meters to zero. This breaks the continuity of this device's history in Homey Energy.",
            "nl": "Zet de meters voor geladen en ontladen energie terug naar nul. Dit onderbreekt de continuïteit van de geschiedenis van dit apparaat in Homey Energie."
          }
        }
      },
      "energy": {
        "homeBattery": true,
        "meterPowerImportedCapability": "meter_power.charged",
        "meterPowerExportedCapability": "meter_power.discharged"
      },
      "pair": [
        {
          "id": "start"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "choose_brand"
          }
        },
        {
          "id": "manual_entry",
          "navigation": {
            "next": "choose_brand"
          }
        },
        {
          "id": "choose_brand",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "manual_entry"
        }
      ],
      "id": "battery",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection",
            "nl": "Verbinding"
          },
          "children": [
            {
              "id": "host",
              "type": "text",
              "label": {
                "en": "Host",
                "nl": "Host"
              },
              "hint": {
                "en": "The IP address or hostname of the battery's datalogger.",
                "nl": "Het IP-adres of de hostnaam van de datalogger van de batterij."
              }
            },
            {
              "id": "port",
              "type": "number",
              "label": {
                "en": "Port",
                "nl": "Poort"
              },
              "value": 8080,
              "min": 1,
              "max": 65535
            },
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Poll interval",
                "nl": "Poll-interval"
              },
              "value": 5,
              "min": 2,
              "max": 300,
              "units": {
                "en": "s",
                "nl": "s"
              },
              "hint": {
                "en": "How often the app reads live values from the battery, in seconds. 2 seconds is a hard floor to avoid flooding the device.",
                "nl": "Hoe vaak de app live waarden van de batterij uitleest, in seconden. 2 seconden is een harde ondergrens om het apparaat niet te overspoelen."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Device",
            "nl": "Apparaat"
          },
          "children": [
            {
              "id": "brand",
              "type": "dropdown",
              "label": {
                "en": "Brand",
                "nl": "Merk"
              },
              "value": "other",
              "values": [
                {
                  "id": "lunergy",
                  "label": {
                    "en": "Lunergy",
                    "nl": "Lunergy"
                  }
                },
                {
                  "id": "sunpura",
                  "label": {
                    "en": "Sunpura",
                    "nl": "Sunpura"
                  }
                },
                {
                  "id": "voltdeer",
                  "label": {
                    "en": "Voltdeer",
                    "nl": "Voltdeer"
                  }
                },
                {
                  "id": "aeg",
                  "label": {
                    "en": "AEG",
                    "nl": "AEG"
                  }
                },
                {
                  "id": "aferiy",
                  "label": {
                    "en": "AFERIY",
                    "nl": "AFERIY"
                  }
                },
                {
                  "id": "accumate",
                  "label": {
                    "en": "AccuMate",
                    "nl": "AccuMate"
                  }
                },
                {
                  "id": "jet",
                  "label": {
                    "en": "JET",
                    "nl": "JET"
                  }
                },
                {
                  "id": "oscal",
                  "label": {
                    "en": "Oscal",
                    "nl": "Oscal"
                  }
                },
                {
                  "id": "other",
                  "label": {
                    "en": "Other",
                    "nl": "Overig"
                  }
                }
              ]
            },
            {
              "id": "model",
              "type": "text",
              "label": {
                "en": "Model",
                "nl": "Model"
              },
              "hint": {
                "en": "Optional. The model name printed on the battery or datalogger.",
                "nl": "Optioneel. De modelnaam die op de batterij of datalogger staat vermeld."
              }
            },
            {
              "id": "serial",
              "type": "label",
              "label": {
                "en": "Serial number",
                "nl": "Serienummer"
              }
            },
            {
              "id": "firmware",
              "type": "label",
              "label": {
                "en": "Firmware version",
                "nl": "Firmwareversie"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Power limits",
            "nl": "Vermogenslimieten"
          },
          "children": [
            {
              "id": "max_charge_power",
              "type": "number",
              "label": {
                "en": "Max charge power",
                "nl": "Max. laadvermogen"
              },
              "value": 800,
              "min": 100,
              "max": 2400,
              "units": {
                "en": "W",
                "nl": "W"
              },
              "hint": {
                "en": "The factory default local cap is 800W. Going higher writes register 3039 to unlock it. The vendor app's separate \"On Grid Output\" setting also caps real charge power, and can only be raised in that app.",
                "nl": "De fabrieksstandaard lokale grens is 800W. Hoger instellen schrijft register 3039 om deze te ontgrendelen. De aparte instelling \"On Grid Output\" in de app van de fabrikant begrenst het werkelijke laadvermogen ook, en kan alleen in die app worden verhoogd."
              }
            },
            {
              "id": "max_discharge_power",
              "type": "number",
              "label": {
                "en": "Max discharge power",
                "nl": "Max. ontlaadvermogen"
              },
              "value": 800,
              "min": 100,
              "max": 2400,
              "units": {
                "en": "W",
                "nl": "W"
              },
              "hint": {
                "en": "The factory default local cap is 800W. Going higher writes register 3039 to unlock it. The vendor app's separate \"On Grid Output\" setting also caps real discharge power, and can only be raised in that app.",
                "nl": "De fabrieksstandaard lokale grens is 800W. Hoger instellen schrijft register 3039 om deze te ontgrendelen. De aparte instelling \"On Grid Output\" in de app van de fabrikant begrenst het werkelijke ontlaadvermogen ook, en kan alleen in die app worden verhoogd."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Advanced",
            "nl": "Geavanceerd"
          },
          "children": [
            {
              "id": "verify_interval",
              "type": "number",
              "label": {
                "en": "Verify interval",
                "nl": "Verificatie-interval"
              },
              "value": 60,
              "min": 0,
              "max": 3600,
              "units": {
                "en": "s",
                "nl": "s"
              },
              "hint": {
                "en": "How often the app re-reads the setpoint and restores it if it drifted, in seconds. Set to 0 to disable this check.",
                "nl": "Hoe vaak de app het setpoint opnieuw uitleest en herstelt als het is afgeweken, in seconden. Zet op 0 om deze controle uit te schakelen."
              }
            }
          ]
        }
      ]
    }
  ],
  "capabilities": {
    "aecc_last_update": {
      "type": "string",
      "title": {
        "en": "Last update",
        "nl": "Laatste update"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "aecc_max_soc": {
      "type": "number",
      "title": {
        "en": "Charge limit",
        "nl": "Oplaadlimiet"
      },
      "units": "%",
      "getable": true,
      "setable": true,
      "min": 50,
      "max": 100,
      "step": 5,
      "decimals": 0,
      "uiComponent": "slider",
      "insights": true
    },
    "aecc_min_soc": {
      "type": "number",
      "title": {
        "en": "Discharge limit",
        "nl": "Ontlaadlimiet"
      },
      "units": "%",
      "getable": true,
      "setable": true,
      "min": 5,
      "max": 50,
      "step": 5,
      "decimals": 0,
      "uiComponent": "slider",
      "insights": true
    },
    "aecc_signal_strength": {
      "type": "number",
      "title": {
        "en": "WiFi signal",
        "nl": "WiFi signaal"
      },
      "units": "dBm",
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    }
  },
  "discovery": {
    "aecc": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "http",
        "protocol": "tcp"
      },
      "id": "{{txt.s_sn}}",
      "conditions": [
        [
          {
            "field": "name",
            "match": {
              "type": "regex",
              "value": "^SXD-mDNS-IF"
            }
          },
          {
            "field": "txt.s_port",
            "match": {
              "type": "regex",
              "value": "^[0-9]+$"
            }
          }
        ]
      ]
    }
  }
}